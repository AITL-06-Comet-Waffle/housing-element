# Which chat provider /api/chat uses: "mock" (default) or "openai".
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=openai. Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: OpenAI model to use (defaults to gpt-4o-mini if unset).
OPENAI_MODEL=gpt-4o-mini

# Pinecone fire-risk RAG — set RAG_ENABLED=true to activate.
RAG_ENABLED=false
PINECONE_API_KEY=
PINECONE_INDEX_NAME=postfire-damage
PINECONE_NAMESPACE=calfire-dins-summary-v1

# Required when RAG_ENABLED=true. Must identify your app per OSM's usage policy.
# Example: housing-element/1.0 (your@email.com)
NOMINATIM_USER_AGENT=
