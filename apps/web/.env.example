# ─── LLM narration ──────────────────────────────────────────────────────────
# Provider for the grounded narrative on POST /api/risk: "mock" (default) or
# "openai". Without a real LLM the route returns a deterministic template
# narrative built from the structured risk values (still fully grounded).
LLM_PROVIDER=mock
# Required only when LLM_PROVIDER=openai. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional OpenAI chat model (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# ─── Risk database (REQUIRED) ────────────────────────────────────────────────
# PostGIS database holding the hazard layers (fire/flood/quake) that POST
# /api/risk queries by point-in-polygon. Matches the ingest scripts + the local
# Docker container in the README.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/homebuyer_data

# ─── Historical color (RAG — optional) ───────────────────────────────────────
# When true, POST /api/risk also retrieves nearby PAST fire/flood/quake events
# from Pinecone as narrative color (never as a risk rating). Leave false to run
# the structured assessment + narration without historical color.
RAG_ENABLED=false
PINECONE_API_KEY=
# Fire — CAL FIRE DINS post-fire damage summaries
PINECONE_INDEX_NAME=postfire-damage
PINECONE_NAMESPACE=calfire-dins-summary-v1
# Flood — NOAA Storm Events (flood-related)
PINECONE_FLOOD_INDEX_NAME=flood-risk
PINECONE_FLOOD_NAMESPACE=noaa-stormevents-ca-floods-v1
# Earthquake — USGS ComCat historical events
PINECONE_EARTHQUAKE_INDEX_NAME=earthquake-risk
PINECONE_EARTHQUAKE_NAMESPACE=usgs-comcat-ca-events-v1

# ─── Parked: legacy /api/chat RAG (not used by /api/risk) ────────────────────
# Only the parked chat RagProvider geocodes via Nominatim. Identify your app per
# OSM policy if you enable that path. Example: housing-element/1.0 (you@email.com)
NOMINATIM_USER_AGENT=
